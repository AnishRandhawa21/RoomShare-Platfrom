# Supabase PostgreSQL Connection Strings
# DATABASE_URL: Transaction Pooler on port 6543 (used by Next.js app in serverless/Vercel)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL: Direct / Session connection on port 5432 (used for migrations and schema updates)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Supabase Auth & Client Keys (Found in Supabase Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Optional: Service Role Key (Keep strictly server-side, never expose to client)
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Cloudflare R2 Image Storage (S3-Compatible Object Storage)
# Found in Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="roomshare-platform"
# Optional: Custom domain / Public CDN endpoint (e.g. https://pub-xxx.r2.dev or https://images.staykro.in)
R2_PUBLIC_DOMAIN="https://pub-your-bucket-id.r2.dev"

# Razorpay Payment Gateway (Use Test keys now, switch to Live keys later in Vercel)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"

# Platform Business Config (Optional, defaults to 10)
STAYKRO_PLUS_PROPERTY_LIMIT=10
NEXT_PUBLIC_APP_URL="https://staykro.in"
